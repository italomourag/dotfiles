{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "size": {
            "maxPrefix": "MB",
            "ndigits": 0
        }
    },
    "logo": {
        "color": { "1": "blue", "2": "blue" },
        "padding": { "top": 1 }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": { "user": "blue", "at": "20", "host": "blue" }
        },
        "break",
        // Identidade do Sistema
        { "type": "os", "key": "󰣇 SO", "keyColor": "blue" },
        { "type": "host", "key": "󰌢 Host", "keyColor": "blue", "format": "{version}" },
        { "type": "kernel", "key": "󰒋 Kernel", "keyColor": "blue" },
        { "type": "uptime", "key": "󱎫 Tempo", "keyColor": "blue" },
        { "type": "packages", "key": "󰏖 Pacotes", "keyColor": "blue" },
        "break",
        // Ambiente de Trabalho (Sua Personalização)
        { "type": "shell", "key": "󱆃 Shell", "keyColor": "blue" },
        { "type": "display", "key": "󰍹 Resolução", "keyColor": "blue", "compactType": "original" },
{ "type": "command", "key": "󱂬 Sessão", "keyColor": "blue", "text": "pgrep -x openbox > /dev/null && echo 'Openbox' || echo 'KDE Plasma'" },
        { "type": "wmtheme", "key": "󰉼 Tema", "keyColor": "blue" },
        { "type": "icons", "key": "󰀻 Ícones", "keyColor": "blue" },
        { "type": "terminal", "key": "󰆍 Terminal", "keyColor": "blue" },
        { "type": "terminalfont", "key": "󰛖 Fonte", "keyColor": "blue", "format": "{/2}{-}{/}{2}{?3} {3}{?}" },
        "break",
        // Especificações de Hardware
        { "type": "cpu", "key": "󰻠 CPU", "keyColor": "blue" },
        { "type": "gpu", "key": "󰢮 GPU", "keyColor": "blue" },
        { "type": "memory", "key": "󰍛 Memória", "keyColor": "blue", "format": "{/1}{-}{/}{/2}{-}{/}{} / {}" },
        { "type": "disk", "key": "󰋊 Disco", "keyColor": "blue" },
        "break",
        "colors",
        "break"
    ]
}
