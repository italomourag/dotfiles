# ~/.config/betterlockscreenrc
# ╔═══════════════════════════════╗
# ║        Opções Gerais          ║
# ╚═══════════════════════════════╝
display_on=0
span_image=false
lock_timeout=300
quiet=false
wallpaper_cmd="feh --bg-fill"
# ╔═══════════════════════════════╗
# ║        Efeitos de Imagem      ║
# ╚═══════════════════════════════╝
fx_list=(blur)
blur_level=15
dim_level=40
pixel_scale=10,1000
solid_color=00000000
# ╔═══════════════════════════════╗
# ║           Posição             ║
# ╚═══════════════════════════════╝
lockargs=(--time-pos="660:370")
lockargs+=(--greeter-pos="660:410")
lockargs+=(--ind-pos="800:490")
lockargs+=(--layout-pos="800:540")
# ╔═══════════════════════════════╗
# ║        Fundo e Sombra         ║
# ╚═══════════════════════════════╝
bgcolor=269cb6cc
loginbox=00000000
loginshadow=00000000
# ╔═══════════════════════════════╗
# ║            Fonte              ║
# ╚═══════════════════════════════╝
font="NotoSans NF"
# ╔═══════════════════════════════╗
# ║        Horário e Texto        ║
# ╚═══════════════════════════════╝
time_format="%d de %B, %H:%M"
timecolor=b7d5de
locktext="(󰌾  Digite a senha para desbloquear)"
greetercolor=b7d5de
# ╔═══════════════════════════════╗
# ║        Anel de Senha          ║
# ╚═══════════════════════════════╝
ringcolor=b7d5de
insidecolor=00000000
separatorcolor=00000000
ringvercolor=e7e8ebff
insidevercolor=8e8e8e
ringwrongcolor=e7e8ebff
insidewrongcolor=d23c3dff
keyhlcolor=1e1e1e
bshlcolor=000000
modifcolor=d23c3dff
# ╔═══════════════════════════════╗
# ║        Textos de Status       ║
# ╚═══════════════════════════════╝
veriftext=""
verifcolor=444444ff
wrongtext=""
wrongcolor=d23c3dff
# ╔═══════════════════════════════╗
# ║        Opções Avançadas       ║
# ╚═══════════════════════════════╝
