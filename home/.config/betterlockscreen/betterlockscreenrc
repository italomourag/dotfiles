# ~/.config/betterlockscreenrc

# ╔═══════════════════════════════╗
# ║        Opções Gerais          ║
# ╚═══════════════════════════════╝
display_on=0
span_image=false
lock_timeout=300
quiet=false
wallpaper_cmd="feh --bg-fill"

# ╔═══════════════════════════════╗
# ║        Efeitos de Imagem      ║
# ╚═══════════════════════════════╝
fx_list=(blur)
blur_level=15
dim_level=40
pixel_scale=10,1000
solid_color=00000000

# ╔═══════════════════════════════╗
# ║           Posição             ║
# ╚═══════════════════════════════╝
lockargs=(--time-pos="ix+-105:iy+100")
lockargs+=(--greeter-pos="ix-130:iy+120")
lockargs+=(--ind-pos="ix+690:iy+480")

# ╔═══════════════════════════════╗
# ║        Fundo e Sombra         ║
# ╚═══════════════════════════════╝
bgcolor=269cb6cc
loginbox=00000000
loginshadow=00000000

# ╔═══════════════════════════════╗
# ║        Tipografia             ║
# ╚═══════════════════════════════╝
font="Roboto Bold"

# ╔═══════════════════════════════╗
# ║        Horário e Texto        ║
# ╚═══════════════════════════════╝
time_format="%d/%m  /  %H:%M"
timecolor=444444
locktext="Digite a senha para desbloquear"
greetercolor=444444
layoutcolor=ffffffff

# ╔═══════════════════════════════╗
# ║        Anel de Senha          ║
# ╚═══════════════════════════════╝
ringcolor=e7e8eb
insidecolor=00000000
separatorcolor=00000000

ringvercolor=e7e8eb
insidevercolor=00000000

ringwrongcolor=e7e8eb
insidewrongcolor=d23c3dff

keyhlcolor=444444
bshlcolor=444444
modifcolor=d23c3dff

# ╔═══════════════════════════════╗
# ║        Textos de Status       ║
# ╚═══════════════════════════════╝
veriftext=""
verifcolor=444444
wrongtext=""
wrongcolor=d23c3dff

# ╔═══════════════════════════════╗
# ║        Opções Avançadas       ║
# ╚═══════════════════════════════╝
